    def test_concurrent_requests_do_not_break_each_other_when_one_client_closes(monkeypatch):
        first_started = threading.Event()
        first_closed = threading.Event()
    
        def first_responder(**kwargs):
            first_started.set()
            first_client.close()
            first_closed.set()
            raise _connection_error()
    
