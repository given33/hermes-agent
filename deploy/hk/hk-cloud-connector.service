[Unit]
Description=Hermes HK cloud collaboration connector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/hk-team
EnvironmentFile=%h/.config/hk-team/cloud_connector.env
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=PYTHONUTF8=1
Environment=PATH=/opt/hk-team/hermes-agent/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /opt/hk-team/hk_cloud_connector.py --interval 2 --quiet --state-file %h/.local/state/hk-cloud-connector/checkpoint.json
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=65 78
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.hermes %h/.local/state/hk-cloud-connector

[Install]
WantedBy=default.target
